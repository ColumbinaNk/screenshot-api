# Server
PORT=8000

# Auth (empty = no auth, for local dev)
API_KEY=

# Rate limit (requests per minute per IP)
RATE_LIMIT=60

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# Browser
BROWSER_TIMEOUT=30
DEFAULT_WIDTH=1280
DEFAULT_HEIGHT=720

# Proxy (optional, global default for all requests)
# Supported: socks5://host:port, http://host:port, https://host:port
# PROXY=socks5://127.0.0.1:1030
